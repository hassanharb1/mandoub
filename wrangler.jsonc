{
  // Cloudflare Worker: serves the PWA (./public) and the accounts/sync API (worker/index.js, /api/*).
  // Deploy: npx wrangler deploy   (updates the existing "mandoub-mestk" worker; the address stays the same)
  "name": "mandoub-mestk",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // the accounts and the synced data (D1). Made once with: npx wrangler d1 create salesgo
  // then paste the database_id it prints here and in wrangler.trial.jsonc
  "d1_databases": [
    { "binding": "DB", "database_name": "salesgo", "database_id": "PASTE-THE-ID-FROM-wrangler-d1-create" }
  ]
}
