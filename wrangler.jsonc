{
  // Cloudflare Worker: serves the PWA (./public) and the accounts/sync API (worker/index.js, /api/*).
  // Deploy: npx wrangler deploy   (updates the existing "mandoub-mestk" worker; the address stays the same)
  "name": "mandoub-mestk",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // the accounts and the synced data (D1). Made once with: npx wrangler d1 create salesgo
  // then paste the database_id it prints here and in wrangler.trial.jsonc
  // reminders as push notifications: the cron pushes what came due (worker/push.js); the private key is the secret VAPID_JWK
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "VAPID_PUBLIC": "BHunE7qGgJWge3Yz_YnWsUtrCp2AyWhtpjbVSWyf1CB0HueRJeK_aJrfSDgFsy_F4BYV7JLVB0TncPH2pC5xZms" },
  "d1_databases": [
    { "binding": "DB", "database_name": "salesgo", "database_id": "b3aa7c8b-38da-419e-b192-0bdd23006e65" }
  ]
}
